PORT=5000
# Use your PostgreSQL provider's connection string. Keep credentials private.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# For local PostgreSQL, sslmode=require may be omitted.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
# Optional comma-separated allowed frontend origins; omit for permissive local development.
# CORS_ORIGIN=http://localhost:5173,https://your-domain.example
# Optional, if uploads need a persistent mounted disk on your hosting provider.
# UPLOADS_DIR=/var/data/uploads
PG_POOL_MAX=10
